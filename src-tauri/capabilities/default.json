{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        "$APPDATA",
        "$APPDATA/**",
        "$APPDATA/*",
        "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Ledger",
        "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Ledger/**",
        "$HOME/Library/Mobile Documents/com~apple~CloudDocs"
      ]
    }
  ]
}
